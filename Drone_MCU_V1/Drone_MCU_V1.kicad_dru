(version 1)
(rule "U5 fine-pitch pad clearance"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == 'U5' && B.Reference == 'U5'")
  (constraint clearance (min 0.15mm))
)

(rule "JLCPCB non-plated hole minimum"
  (condition "A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_size (min 0.5mm))
)

(rule "U5 solder mask opening separation"
  (layer "F.Mask")
  (condition "A.Reference == 'U5' && B.Reference == 'U5'")
  (constraint physical_clearance (min 0.1mm))
)
